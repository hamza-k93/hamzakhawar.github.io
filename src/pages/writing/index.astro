---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { getCollection } from 'astro:content';

const entries = (
  await getCollection('writing', ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<BaseLayout title="Writing · ~/hamza" description="Essays and notes by Hamza Khawar.">
  <header class="hero">
    <h1 class="lede fade-in d1">
      Writing — <em>essays, notes, and field reports</em>.
    </h1>
    <p class="sub fade-in d2">
      Loosely organized. Slowly written. Subscribe via <a href="/rss.xml">RSS</a>.
    </p>
  </header>

  <section class="fade-in d3">
    <EntryList entries={entries} />
  </section>
</BaseLayout>
