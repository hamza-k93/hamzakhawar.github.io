---
import BaseLayout from '../layouts/BaseLayout.astro';

const principles = [
  'Start with the data and constraints that actually exist.',
  'Check the assumptions before treating the result as real.',
  'Write things down when the decision matters.',
  'Build the simplest system that will hold up under the load.',
];

const focusAreas = [
  {
    label: 'Data Platform & Infrastructure',
    text: 'Building the platforms, systems, and foundations that keep data reliable, accessible, and scalable.',
  },
  {
    label: 'Analytics & Experimentation',
    text: 'Metrics, semantic models, and experiments that help teams understand what’s happening and decide what to do next.',
  },
  {
    label: 'Applied ML & Data Products',
    text: 'Building models that power prediction, personalization, and automation in products.',
  },
];

const timeline = [
  {
    period: 'Now',
    title: 'Principal Data Scientist, US Mobile',
    text: 'End-to-end ownership across data platform, analytics, experimentation, and ML.',
  },
  {
    period: 'Before',
    title: 'Meta and Turo',
    text: 'Product judgment through measurement, experimentation, and growth.',
  },
  {
    period: 'Foundation',
    title: 'Berkeley M.Eng.',
    text: 'Foundations in systems and applied problem-solving.',
  },
];
---
<BaseLayout title="About · ~/hamza" description="About Hamza Khawar.">
  <header class="hero about-hero">
    <p class="eyebrow fade-in d1">About</p>
    <h1 class="lede fade-in d1">
      I work at the intersection of <em>data, systems, and product decisions</em>.
    </h1>
    <p class="sub fade-in d2">
      Hi, I’m Hamza Khawar. I work across the data lifecycle, from infrastructure and modeling to analytics, 
      experimentation, and applied ML. I focus on building the foundations that make data useful.
    </p>
  </header>

  <main class="about-page fade-in d3">
    <section class="about-intro">
      <div class="section-kicker">What I spend time on</div>
      <div class="intro-copy">
        <p>
          A lot of my work starts with ambiguity: unclear metrics, messy systems, incomplete signals, or decisions that need better evidence. 
          I like turning that ambiguity into something more structured—whether that means improving the underlying data, 
          designing a better measurement approach, or building a system a team can rely on.
        </p>
        <p>
          This site is a notebook for that work. Some posts are technical, some are notes from problems I’ve spent time with and
          some are just me trying to say something plainly.
        </p>
      </div>
    </section>

    <section class="about-grid" aria-label="Areas of focus">
      {focusAreas.map((area) => (
        <article class="focus-card">
          <span>{area.label}</span>
          <p>{area.text}</p>
        </article>
      ))}
    </section>

    <section class="about-section">
      <div class="section-kicker">Work history</div>
      <div class="timeline">
        {timeline.map((item) => (
          <article class="timeline-item">
            <div class="timeline-period">{item.period}</div>
            <div>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="about-section principles">
      <div class="section-kicker">How I try to work</div>
      <ol>
        {principles.map((principle) => <li>{principle}</li>)}
      </ol>
    </section>

    <section class="about-section note">
      <div class="section-kicker">Contact</div>
      <p>
        The easiest way to reach me is email:
        <a href="mailto:hamzakhawar993@gmail.com">hamzakhawar993@gmail.com</a>.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .about-hero {
    margin-bottom: 64px;
  }

  .eyebrow,
  .section-kicker {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .about-page {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .about-intro,
  .about-section {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 32px;
    border-top: 1px solid var(--rule);
    padding-top: 28px;
  }

  .intro-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.72;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .focus-card {
    min-height: 172px;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    border-radius: 4px;
    padding: 18px;
  }

  .focus-card span {
    display: block;
    margin-bottom: 18px;
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .focus-card p,
  .timeline-item p,
  .note p {
    color: var(--ink-2);
    font-size: 14.5px;
    line-height: 1.65;
  }

  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 24px;
    padding: 0 0 24px;
  }

  .timeline-item + .timeline-item {
    border-top: 1px solid var(--rule);
    padding-top: 24px;
  }

  .timeline-period {
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    color: var(--ink-4);
    letter-spacing: 0.04em;
  }

  .timeline-item h2 {
    font-family: "Source Serif 4", Georgia, serif;
    font-variation-settings: "opsz" 24;
    font-size: 21px;
    line-height: 1.25;
    font-weight: 450;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .principles ol {
    list-style: none;
    counter-reset: principles;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .principles li {
    counter-increment: principles;
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 16px;
    align-items: baseline;
    color: var(--ink-2);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .principles li::before {
    content: counter(principles, decimal-leading-zero);
    font-family: "IBM Plex Mono", monospace;
    font-size: 11px;
    color: var(--ink-4);
  }

  .note a {
    border-bottom: 1px solid var(--rule-2);
    padding-bottom: 1px;
  }

  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .focus-card {
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    .about-hero {
      margin-bottom: 52px;
    }

    .about-intro,
    .about-section,
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .about-page {
      gap: 44px;
    }
  }
</style>
